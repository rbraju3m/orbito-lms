APP_NAME=Orbito
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Comma-separated origins allowed to call the API with credentials (the SPA).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# --- The permanent platform owner ---
# Created and repaired after every migration, and protected from deletion,
# suspension and demotion. The password is written ONCE, when the account is
# first created; changing it here later does nothing. Changing the EMAIL moves
# the protection to that address rather than protecting a second account.
# Defaults live in config/orbito.php; override them for a real deployment.
PLATFORM_OWNER_NAME=Raju
PLATFORM_OWNER_EMAIL=rbraju3m@gmail.com
# PLATFORM_OWNER_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orbito_lms
DB_USERNAME=orbito
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=orbito

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@orbito.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Orbito platform ---
ORBITO_BASE_CURRENCY=BDT
ORBITO_SUPPORTED_CURRENCIES=BDT,USD
ORBITO_SUPPORTED_LOCALES=en,bn

# --- Media / storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Payment gateways (Phase 10) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- AI (Phase 17, optional; the app runs fully without these) ---
AI_PROVIDER=null
ANTHROPIC_API_KEY=

# Signed-URL lifetime for private media, in minutes.
MEDIA_SIGNED_URL_TTL=15
